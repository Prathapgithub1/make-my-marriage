generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  email               String               @unique(map: "users_email_key") @db.VarChar(320)
  passwordHash        String               @map("password_hash") @db.VarChar(255)
  displayName         String?                  @map("display_name") @db.VarChar(120)
  emailVerifiedAt     DateTime?                @map("email_verified_at") @db.Timestamptz(6)
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  weddingMembership   WeddingMembership?
  weddingsCreated     Wedding[]            @relation("WeddingsCreated")

  @@map("users")
}

enum WeddingRole {
  ADMIN
  MANAGER
}

enum WebsiteTheme {
  CLASSIC
  MINIMAL
  MODERN
}

model Wedding {
  id              String            @id @default(uuid()) @db.Uuid
  title           String            @db.VarChar(160)
  brideName       String            @map("bride_name") @db.VarChar(120)
  groomName       String            @map("groom_name") @db.VarChar(120)
  weddingDate     DateTime?         @map("wedding_date") @db.Date
  location        String?           @db.VarChar(255)
  city            String?           @db.VarChar(120)
  state           String?           @db.VarChar(120)
  country         String?           @db.VarChar(120)
  description     String?           @db.Text
  coverImageKey   String?           @map("cover_image_key") @db.VarChar(1024)
  createdByUserId String            @map("created_by_user_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdByUser       User              @relation("WeddingsCreated", fields: [createdByUserId], references: [id], onDelete: Restrict)
  memberships         WeddingMembership[]
  websiteSettings     WebsiteSettings?
  galleryAccessTokens GalleryAccessToken[]

  @@index([weddingDate], map: "weddings_wedding_date_idx")
  @@map("weddings")
}

model WeddingMembership {
  id        String      @id @default(uuid()) @db.Uuid
  weddingId String      @map("wedding_id") @db.Uuid
  userId    String      @unique(map: "wedding_memberships_user_id_key") @map("user_id") @db.Uuid
  role      WeddingRole @default(MANAGER)
  joinedAt  DateTime    @default(now()) @map("joined_at") @db.Timestamptz(6)

  wedding   Wedding     @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([weddingId], map: "wedding_memberships_wedding_id_idx")
  @@map("wedding_memberships")
}

model WebsiteSettings {
  id          String       @id @default(uuid()) @db.Uuid
  weddingId   String       @unique(map: "website_settings_wedding_id_key") @map("wedding_id") @db.Uuid
  slug        String       @unique(map: "website_settings_slug_key") @db.VarChar(180)
  theme       WebsiteTheme @default(CLASSIC)
  isPublished Boolean      @default(false) @map("is_published")
  content     Json?
  publishedAt DateTime?    @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  wedding     Wedding      @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@map("website_settings")
}

model GalleryAccessToken {
  id        String    @id @default(uuid()) @db.Uuid
  weddingId String    @map("wedding_id") @db.Uuid
  tokenHash String    @unique(map: "gallery_access_tokens_token_hash_key") @map("token_hash") @db.VarChar(128)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  wedding   Wedding   @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@index([weddingId, revokedAt], map: "gallery_access_tokens_wedding_id_revoked_at_idx")
  @@index([expiresAt], map: "gallery_access_tokens_expires_at_idx")
  @@map("gallery_access_tokens")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique(map: "sessions_token_hash_key") @map("token_hash") @db.VarChar(128)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt], map: "sessions_user_id_expires_at_idx")
  @@index([expiresAt], map: "sessions_expires_at_idx")
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique(map: "password_reset_tokens_token_hash_key") @map("token_hash") @db.VarChar(128)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt], map: "password_reset_tokens_user_id_expires_at_idx")
  @@map("password_reset_tokens")
}

model AuthRateLimit {
  key             String   @id @db.VarChar(64)
  count           Int      @default(1)
  windowStartedAt DateTime @map("window_started_at") @db.Timestamptz(6)
  expiresAt       DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([expiresAt], map: "auth_rate_limits_expires_at_idx")
  @@map("auth_rate_limits")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique(map: "email_verification_tokens_token_hash_key") @map("token_hash") @db.VarChar(128)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt], map: "email_verification_tokens_user_id_expires_at_idx")
  @@map("email_verification_tokens")
}

