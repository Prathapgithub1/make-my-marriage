# API process settings for local development
API_PORT=3104
PORT=1234
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:1234
APP_BASE_URL=http://localhost:1234
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=onboarding@resend.dev

# DATABASE_URL will be added when the Prisma schema and local PostgreSQL setup are agreed.
DATABASE_URL_LOCAL=postgresql://postgres:your_local_password@localhost:5432/makeMyMarriage?schema=public
# Production database URL — replace with your own AWS RDS / Cloud SQL instance
DATABASE_URL=postgresql://postgres:your_db_password@your-db-host.rds.amazonaws.com:5432/makemymarriage?sslmode=require
# Local browser-to-API and development auth settings
# Generate secure random values: node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
SESSION_SECRET=replace_with_a_64_byte_random_base64url_string
CSRF_SECRET=replace_with_another_64_byte_random_base64url_string
API_BASE_URL=http://localhost:3104/api/v1
