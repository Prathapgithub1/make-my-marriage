{
  "name": "@mmm/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec \"node --env-file-if-exists=../../.env --import tsx\" src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "test": "jest --config jest.config.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "^0.45.1",
    "dotenv": "^16.6.1",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "nodemon": "^3.1.14",
    "prisma": "7.10.0",
    "supertest": "7.3.1",
    "ts-jest": "29.4.14",
    "tsx": "4.23.15"
  }
}
